# Copy to .env before running docker compose or the backend.
# Values below are development defaults — never reuse them in production.

NODE_ENV=development
PORT=3000
SWAGGER_ENABLED=true

# --- Postgres ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=agromagnat
DB_PASSWORD=agromagnat
DB_NAME=agromagnat
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=agromagnat
S3_ACCESS_KEY=agromagnat
S3_SECRET_KEY=agromagnat
S3_PUBLIC_URL=http://localhost:9000/agromagnat

# --- Auth ---
# Development placeholders. The app REFUSES TO START with these when
# NODE_ENV=production — this repository is public, so these two strings are
# public, and `role` travels inside the access token. Generate real ones with
# `openssl rand -hex 32`.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_TTL=30d

# --- SMS (Eskiz.uz). Keep "mock" in dev: OTP is always 000000 and logged. ---
SMS_PROVIDER=mock
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_FROM=4546

# --- Push (Firebase Cloud Messaging). Keep "mock" in dev: nothing is sent,
#     notifications are logged. FCM_* come from a service-account JSON key. ---
PUSH_PROVIDER=mock
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Google sign-in ---
# Empty disables the route; the phone path still works.
# The same client id has to reach the browser for Google's button to render,
# and it is not a secret — it is published in every page that shows the button.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Telegram (free OTP delivery + bot) ---
# With a bot token, TELEGRAM_WEBHOOK_SECRET is REQUIRED: without it anyone who
# guesses the webhook URL can bind their chat to another account and receive
# that person's login codes. Generate with `openssl rand -hex 24`.
TELEGRAM_BOT_TOKEN=
# Without the @. Needed for "sign in with Telegram": the browser opens
# t.me/<username> and the bot asks the person to share their number, which
# Telegram has already verified. Free, unlimited, and no code to send.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- Telegram Gateway (codes straight to a phone number's Telegram) ---
# The cheapest way to reach a NEW visitor: no aggregator contract, no company
# documents, no template moderation, roughly $0.01 a code. Unlike the bot above
# it needs no prior binding — it finds the Telegram account from the number.
# Tried before SMS; a number with no Telegram falls through to SMS.
# Token from https://gateway.telegram.org — see docs/ESKIZ.md.
TELEGRAM_GATEWAY_TOKEN=
# Optional: a verified channel username shown as the sender.
TELEGRAM_GATEWAY_SENDER=
TELEGRAM_GATEWAY_TTL=300

# --- AI ---
# `local` needs no key and no network: category suggestion and the draft parser
# run off an Uzbek keyword lexicon. `anthropic` adds the model on top and falls
# back to `local` whenever the API cannot be reached.
AI_PROVIDER=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# --- Voice transcription (OpenAI-compatible endpoint behind AiService) ---
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TRANSCRIBE_MODEL=whisper-1
