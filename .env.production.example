# Production environment. Copy to .env on the server, next to
# docker-compose.prod.yml, and fill in EVERY value marked CHANGE.
#
# This one file feeds both docker compose interpolation and the backend
# container (env_file), so hostnames refer to compose service names.

NODE_ENV=production
PORT=3000

# Swagger stays off in production — the API surface is not a public document.
SWAGGER_ENABLED=false

# --- Postgres (internal only; never published on a host port) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=agromagnat
DB_PASSWORD=CHANGE__long_random_password
DB_NAME=agromagnat
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- S3 / MinIO ---
# S3_PUBLIC_URL is what gets written into photo URLs in the database: nginx
# maps /storage/<bucket>/<key> onto MinIO, so it must include the bucket.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=agromagnat
S3_ACCESS_KEY=agromagnat
S3_SECRET_KEY=CHANGE__long_random_secret
S3_PUBLIC_URL=https://agromagnat.uz/storage/agromagnat

# --- Auth ---
# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE__openssl_rand_hex_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=CHANGE__openssl_rand_hex_32_different
JWT_REFRESH_TTL=30d

# --- SMS (Eskiz.uz) ---
# "eskiz" in production. With "mock" the OTP is always 000000 — anyone could
# log in as anyone, so the backend must never ship to users with mock enabled.
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=CHANGE__eskiz_account_email
ESKIZ_PASSWORD=CHANGE__eskiz_account_password
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_FROM=4546

# --- AI (OpenAI-compatible endpoint behind AiService) ---
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=CHANGE__api_key
AI_MODEL=gpt-4o-mini
AI_TRANSCRIBE_MODEL=whisper-1

# --- Web (NEXT_PUBLIC_* are baked into the client bundle at image build) ---
NEXT_PUBLIC_API_URL=https://agromagnat.uz/api
NEXT_PUBLIC_S3_URL=https://agromagnat.uz
NEXT_PUBLIC_SITE_URL=https://agromagnat.uz
